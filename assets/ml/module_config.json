{
 "source": "Nexus_Element_Configurator/ModuleConfig.xlsx",
 "notes": {
  "flags": "MODULES columns as in the workbook: CIRC circulation, VAL max tree degree, FAC needs facade, PRIV/VIEW/SOLAR requirement, PRIM primary orientation, INDOOR, ACCESS needs access cell, GROUND level 0 only, DOUBLE double-height capable, FAC_N/E/S/W allowed facade sides in module-local frame, OTS open to sky, PART partition level, SYM symmetric block.",
  "reward": "REWARD MATRIX entries > 0 as [a, b, value] (upper triangle as in the workbook; treat as symmetric). A pair is an allowed connection if it has reward > 0 or adjacency regulation > 0; weight = value * 10.",
  "adjacency": "ADJECENCY REGULATION entries > 0: mandatory connections (edge must be active on exactly one level when both modules are placed).",
  "rotation_pairs": "Allowed [rot_a, rot_b] when module b is the neighbour of a in direction dir (element_house_solver.module_orientation_const).",
  "facade_rotation": "A facade on world side d_f is allowed for rotation k if the module-local side (d_f + k) mod 4 has FAC_<side> true, sides indexed N=0,E=1,S=2,W=3 (val = (d_m - d_f) % 4 in the solver).",
  "brief_rules": "Brief.load_modules: shared bathroom per 2 bedrooms (incl. guest); stairs = one per level when max_levels > 1 (House); voids CON_00 for double-height living/dining with module_below."
 },
